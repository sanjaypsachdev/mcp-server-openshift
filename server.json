{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.sanjaypsachdev/mcp-server-openshift",
  "title": "OpenShift MCP Server",
  "description": "OpenShift/Kubernetes cluster management via the oc CLI for MCP clients",
  "repository": {
    "url": "https://github.com/sanjaypsachdev/mcp-server-openshift",
    "source": "github"
  },
  "version": "0.0.0",
  "websiteUrl": "https://github.com/sanjaypsachdev/mcp-server-openshift#readme",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "mcp-server-openshift",
      "version": "0.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "OPENSHIFT_CONTEXT",
          "description": "Default OpenShift/Kubernetes context"
        },
        {
          "name": "OPENSHIFT_NAMESPACE",
          "description": "Default namespace/project",
          "default": "default"
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "docker.io/sanjaypsachdev/mcp-server-openshift:0.0.0",
      "runtimeHint": "docker",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "-i",
          "description": "Keep stdin open for stdio MCP transport"
        },
        {
          "type": "named",
          "name": "-v",
          "value": "{kube_config}:/home/nodejs/.kube:ro",
          "description": "Mount host kubeconfig so oc can reach the cluster",
          "variables": {
            "kube_config": {
              "description": "Path to kubeconfig on host",
              "format": "filepath",
              "default": "~/.kube/config"
            }
          }
        }
      ],
      "environmentVariables": [
        {
          "name": "OPENSHIFT_CONTEXT",
          "description": "Default OpenShift/Kubernetes context"
        },
        {
          "name": "OPENSHIFT_NAMESPACE",
          "description": "Default namespace/project",
          "default": "default"
        }
      ]
    }
  ]
}
